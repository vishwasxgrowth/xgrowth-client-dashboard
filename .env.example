# Point at the deployed proxy (server-side AdMob token + ClickUp). Example:
# https://us-central1-dolphin-fdffc.cloudfunctions.net/xgClientApi
VITE_FUNCTIONS_BASE_URL=

# Which client this deployment is for (key into the server's refresh-token map)
VITE_CLIENT_ID=jedyapps

VITE_CLIENT_NAME=JedyApps
VITE_CLIENT_ADMOB_ACCOUNT=accounts/pub-8519912990016124
VITE_CLIENT_CLICKUP_FOLDER=901210858217

# Google OAuth (only needed if NOT using the proxy). Leave empty when proxy is set.
VITE_GOOGLE_CLIENT_ID=

# TEMP dev override (Playground token). Leave EMPTY now that the proxy is live.
VITE_DEV_ACCESS_TOKEN=
